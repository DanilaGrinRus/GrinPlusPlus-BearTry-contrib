+	}
+
+	LOG_INFO_F("G49T phase=kernel_history ms={} heights={}",
+		G49NowMs() - phaseStart, blockHeader.GetHeight() + 1);
+	phaseStart = G49NowMs();
+	syncStatus.UpdateProcessingStatus(25);
+
+	// Validate kernel sums
+	LOG_DEBUG("Validating kernel sums");
+	LoggerAPI::Flush();
+
+	std::unique_ptr<BlockSums> pBlockSums = nullptr;
+	try
+	{
+		pBlockSums = std::make_unique<BlockSums>(ValidateKernelSums(txHashSet, blockHeader));
+	}
+	catch (...)
+	{
+		LOG_ERROR("Invalid kernel sums");
+		return std::unique_ptr<BlockSums>(nullptr);
+	}
+
+	LOG_INFO_F("G49T phase=kernel_sums ms={} kernels={} outputs={}",
+		G49NowMs() - phaseStart,
+		blockHeader.GetNumKernels(),
+		blockHeader.GetNumOutputs());
+	phaseStart = G49NowMs();
+	syncStatus.UpdateProcessingStatus(40);
+
+	// Validate the rangeproof associated with each unspent output.
+	LOG_DEBUG("Validating range proofs");
+	LoggerAPI::Flush();
+	if (!ValidateRangeProofs(txHashSet, syncStatus))
+	{
+		LOG_ERROR("Failed to verify rangeproofs");
+		return std::unique_ptr<BlockSums>(nullptr);
+	}
+
+	LOG_INFO_F("G49T phase=range_proofs_phase ms={}", G49NowMs() - phaseStart);
+	phaseStart = G49NowMs();
+	syncStatus.UpdateProcessingStatus(70);
+
+	// Validate kernel signatures
+	LOG_DEBUG("Validating kernel signatures");
+	LoggerAPI::Flush();
+	if (!ValidateKernelSignatures(*txHashSet.GetKernelMMR(), syncStatus))
+	{
+		LOG_ERROR("Failed to verify kernel signatures");
+		return std::unique_ptr<BlockSums>(nullptr);
+	}
+
+	LOG_INFO_F("G49T phase=kernel_signatures ms={} kernels={}",
+		G49NowMs() - phaseStart, blockHeader.GetNumKernels());
+	LOG_DEBUG("Success");
+	LoggerAPI::Flush();
+
+	LOG_INFO_F(
+		"G49T roots kernel={} output={} rangeproof={}",
+		blockHeader.GetKernelRoot().ToHex(),
+		blockHeader.GetOutputRoot().ToHex(),
+		blockHeader.GetRangeProofRoot().ToHex());
+	LOG_INFO_F(
+		"G49T sums output={} kernel={}",
+		pBlockSums->GetOutputSum().ToHex(),
+		pBlockSums->GetKernelSum().ToHex());
+	LOG_INFO_F("G49T phase=validate_total ms={}", G49NowMs() - validateStart);
+
+	syncStatus.UpdateProcessingStatus(100);
+
+	return pBlockSums;
+}
