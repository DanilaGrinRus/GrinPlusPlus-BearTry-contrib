new file mode 100644
index 0000000..e92da01
--- /dev/null
+++ b/tests/src/P2P/Test_StateSyncerInvariants.cpp
@@ -0,0 +1,34 @@
+#include <catch.hpp>
+
+#include "../PMMR/Test_NrdSupport.h"
+#include <P2P/Sync/StateSyncer.h>
+
+#include <filesystem.h>
+
+TEST_CASE("StateSyncer flushed/confirmed invariant fails closed")
+{
+	const BlockHeaderPtr pA = NrdTest::MakeHeader(4, 10, HASH::ZERO, 1, 1);
+	const BlockHeaderPtr pB = NrdTest::MakeHeader(4, 10, HASH::ZERO, 1, 2);
+
+	std::string reason;
+	REQUIRE(StateSyncer::FlushedMatchesConfirmed(pA, pA, &reason));
+	REQUIRE(reason.empty());
+	REQUIRE_FALSE(StateSyncer::FlushedMatchesConfirmed(pA, pB, &reason));
+	REQUIRE_FALSE(reason.empty());
+	REQUIRE_FALSE(StateSyncer::FlushedMatchesConfirmed(nullptr, pA, &reason));
+	REQUIRE_FALSE(StateSyncer::FlushedMatchesConfirmed(pA, nullptr, &reason));
+}
+
+TEST_CASE("StateSyncer recovery marker probe rejects unwritable path")
+{
+	const fs::path root = fs::temp_directory_path() / "state-syncer-marker-probe";
+	std::error_code error;
+	fs::remove_all(root, error);
+	fs::create_directories(root / "marker_is_dir", error);
+	REQUIRE_FALSE(error);
+
+	REQUIRE_FALSE(StateSyncer::IsRecoveryMarkerPathWritable(root / "marker_is_dir"));
+	REQUIRE(StateSyncer::IsRecoveryMarkerPathWritable(root / "recovery_failed"));
+
+	fs::remove_all(root, error);
+}
