{
  "format_version": 1,
  "description": "Machine-readable NRD (NoRecentDuplicate) differential cases for Grin++ vs Rust grin 5.5.2. Each case builds the kernel MMR + header chain, optionally rebuilds the recent NRD index from kernel MMR + headers only (PIBD without bodies), then applies one target block and records the decision category. The C++ runner is tests/src/PMMR/Test_NrdDifferential.cpp.",
  "network": "AutomatedTesting",
  "header_version_default": 4,
  "reference": {
    "rust_crate_version": "5.5.2",
    "claimed_commit": "dbaff34",
    "commit_provenance": "NOT VERIFIED: the reference tree has no .git metadata of its own; version is taken from Cargo.toml. Tree SHA-256 manifest: tools/audit/nrd/evidence/grin-5.5.2-reference-sha256.txt",
    "oracle_runs": [
      "cargo test --release -p grin_chain --test nrd_validation_rules (3 passed)",
      "cargo test --release -p grin_chain --test store_kernel_pos_index (5 passed)",
      "cargo test --release -p grin_core --test block (27 passed)",
      "cargo test --release -p grin_pool --test nrd_kernel_relative_height (1 passed)",
      "cargo test --release -p grin_pool --test nrd_kernels_disabled (1 passed)",
      "cargo test --release -p grin_pool --test nrd_kernels_enabled (1 passed)",
      "cargo test --release -p grin_core --lib nrd (3 passed)"
    ]
  },
  "categories": {
    "accepted": "NRD kernel accepted by the relative-height rule",
    "accepted_non_nrd": "target block has no NRD kernels; NRD rule not applicable",
    "invalid_nrd_relative_height": "NRD duplicate inside the recent window violates relative_height (Rust chain::Error::NRDRelativeHeight)",
    "invalid_nrd_duplicate_in_block": "two NRD kernels with the same excess in one target block (Rust core::transaction::verify_no_nrd_duplicates)",
    "missing_local_history": "client has no complete recent-kernel index; fail-closed local-data category, not a proof of remote invalidity",
    "malformed_input": "kernel bytes fail deserialization (e.g. relative_height outside 1..=WEEK_HEIGHT)"
  },
  "cases": [
    {
      "id": "first-occurrence-accepted",
      "mode": "rebuild",
      "blocks": [
        { "kernels": [] }
      ],
      "target": [{ "features": "nrd", "excess": 100, "relative_height": 2 }],
      "expect": {
        "cpp_category": "accepted",
        "expected_rust_category": "accepted",
        "rust_oracle": "chain/tests/nrd_validation_rules.rs process_block_nrd_validation (block_valid_9, first inclusion)"
      }
    },
    {
      "id": "exact-boundary-accepted",
      "mode": "rebuild",
      "blocks": [
        { "kernels": [] },
        { "kernels": [{ "features": "nrd", "excess": 101, "relative_height": 2 }] },
        { "kernels": [] }
      ],
      "target": [{ "features": "nrd", "excess": 101, "relative_height": 2 }],
      "expect": {
        "cpp_category": "accepted",
        "expected_rust_category": "accepted",
        "rust_oracle": "chain/tests/nrd_validation_rules.rs process_block_nrd_validation (height 11, diff == relative_height)"
      }
    },
    {
      "id": "one-before-boundary-invalid",
      "mode": "rebuild",
      "blocks": [
        { "kernels": [] },
        { "kernels": [{ "features": "nrd", "excess": 102, "relative_height": 2 }] }
      ],
      "target": [{ "features": "nrd", "excess": 102, "relative_height": 2 }],
      "expect": {
        "cpp_category": "invalid_nrd_relative_height",
        "expected_rust_category": "NRDRelativeHeight",
        "rust_oracle": "chain/tests/nrd_validation_rules.rs process_block_nrd_validation (height 10, diff == relative_height - 1)"
      }
    },
    {
      "id": "relative-height-1-next-block-accepted",
      "mode": "rebuild",
      "blocks": [
        { "kernels": [] },
        { "kernels": [{ "features": "nrd", "excess": 103, "relative_height": 1 }] }
      ],
      "target": [{ "features": "nrd", "excess": 103, "relative_height": 1 }],
      "expect": {
        "cpp_category": "accepted",
        "expected_rust_category": "accepted",
        "rust_oracle": "chain/tests/nrd_validation_rules.rs process_block_nrd_validation_relative_height_1"
      }
    },
    {
      "id": "three-occurrences-boundary-accepted",
      "mode": "rebuild",
      "blocks": [
        { "kernels": [{ "features": "nrd", "excess": 104, "relative_height": 2 }] },
        { "kernels": [] },
        { "kernels": [{ "features": "nrd", "excess": 104, "relative_height": 2 }] },
        { "kernels": [] }
      ],
      "target": [{ "features": "nrd", "excess": 104, "relative_height": 2 }],
      "expect": {
        "cpp_category": "accepted",
        "expected_rust_category": "accepted",
        "rust_oracle": "pool/tests/nrd_kernel_relative_height.rs (multiple duplicated NRD kernels accepted while relative_height is met) + chain/tests/nrd_validation_rules.rs"
      }
    },
    {
      "id": "duplicate-nrd-in-one-block-invalid",
      "mode": "rebuild",
      "blocks": [
        { "kernels": [] }
      ],
      "target": [
        { "features": "nrd", "excess": 105, "relative_height": 2 },
        { "features": "nrd", "excess": 105, "relative_height": 2 }
      ],
      "expect": {
        "cpp_category": "invalid_nrd_duplicate_in_block",
        "expected_rust_category": "NRDRelativeHeight",
        "rust_oracle": "core/src/core/transaction.rs verify_no_nrd_duplicates; chain/tests/nrd_validation_rules.rs (block with both tx1 and tx2 invalid)"
      }
    },
    {
      "id": "plain-excess-not-indexed",
      "mode": "rebuild",
      "blocks": [
        { "kernels": [{ "features": "plain", "excess": 106 }] }
      ],
      "target": [{ "features": "nrd", "excess": 106, "relative_height": 5 }],
      "expect": {
        "cpp_category": "accepted",
        "expected_rust_category": "accepted",
        "rust_oracle": "chain/src/txhashset/txhashset.rs apply_kernel_rules only indexes KernelFeatures::NoRecentDuplicate; core verify_no_nrd_duplicates filters NRD only"
      }
    },
    {
      "id": "plain-repeat-accepted",
      "mode": "incremental",
      "blocks": [
        { "kernels": [{ "features": "plain", "excess": 107 }] },
        { "kernels": [{ "features": "plain", "excess": 107 }] }
      ],
      "target": [{ "features": "plain", "excess": 107 }],
      "expect": {
        "cpp_category": "accepted_non_nrd",
        "expected_rust_category": "accepted",
        "rust_oracle": "core/src/core/transaction.rs (NRD rules apply only to NoRecentDuplicate kernels); chain tests mine plain coinbase kernels freely"
      }
    },
    {
      "id": "multi-kernel-mixed-block-attribution",
      "mode": "rebuild",
      "blocks": [
        { "kernels": [{ "features": "nrd", "excess": 108, "relative_height": 2 }] },
        { "kernels": [{ "features": "plain", "excess": 109 }, { "features": "nrd", "excess": 110, "relative_height": 3 }] }
      ],
      "target": [{ "features": "nrd", "excess": 108, "relative_height": 2 }],
      "expect": {
        "cpp_category": "accepted",
        "expected_rust_category": "accepted",
        "rust_oracle": "chain/tests/nrd_validation_rules.rs (multi-kernel blocks incl. coinbase) + chain/src/txhashset/txhashset.rs verify_kernel_pos_index header attribution"
      }
    },
    {
      "id": "missing-local-history",
      "mode": "no_index",
      "blocks": [
        { "kernels": [] }
      ],
      "target": [{ "features": "nrd", "excess": 111, "relative_height": 2 }],
      "expect": {
        "cpp_category": "missing_local_history",
        "expected_rust_category": "not_applicable_local_state",
        "rust_oracle": "Rust has no 'index missing' state: the index is rebuilt inside txhashset write/startup. Category is a local incompleteness guard, not invalid-peer evidence."
      }
    },
    {
      "id": "rebuild-rejects-historical-violation",
      "mode": "rebuild",
      "rebuild_complete": false,
      "blocks": [
        { "kernels": [{ "features": "nrd", "excess": 112, "relative_height": 3 }] },
        { "kernels": [] },
        { "kernels": [{ "features": "nrd", "excess": 112, "relative_height": 3 }] }
      ],
      "target": [{ "features": "nrd", "excess": 113, "relative_height": 2 }],
      "expect": {
        "cpp_category": "missing_local_history",
        "expected_rust_category": "NRDRelativeHeight",
        "rust_oracle": "chain/src/txhashset/txhashset.rs verify_kernel_pos_index replays apply_kernel_rules (line ~602); a historical violation errors the rebuild, which fails txhashset write in chain.rs"
      }
    },
    {
      "id": "rebuild-rejects-duplicate-history-block",
      "mode": "rebuild",
      "rebuild_complete": false,
      "blocks": [
        {
          "kernels": [
            { "features": "nrd", "excess": 114, "relative_height": 2 },
            { "features": "nrd", "excess": 114, "relative_height": 2 }
          ]
        }
      ],
      "target": [{ "features": "nrd", "excess": 115, "relative_height": 2 }],
      "expect": {
        "cpp_category": "missing_local_history",
        "expected_rust_category": "NRDRelativeHeight",
        "rust_oracle": "chain/src/txhashset/txhashset.rs verify_kernel_pos_index: second kernel with same excess at the same height has diff 0 < relative_height"
      }
    },
    {
      "id": "incremental-one-before-boundary-invalid",
      "mode": "incremental",
      "blocks": [
        { "kernels": [{ "features": "nrd", "excess": 116, "relative_height": 2 }] }
      ],
      "target": [{ "features": "nrd", "excess": 116, "relative_height": 2 }],
      "expect": {
        "cpp_category": "invalid_nrd_relative_height",
        "expected_rust_category": "NRDRelativeHeight",
        "rust_oracle": "chain/tests/nrd_validation_rules.rs process_block_nrd_validation (height 10)"
      }
    },
    {
      "id": "incremental-exact-boundary-accepted",
      "mode": "incremental",
      "blocks": [
        { "kernels": [{ "features": "nrd", "excess": 117, "relative_height": 2 }] },
        { "kernels": [] }
      ],
      "target": [{ "features": "nrd", "excess": 117, "relative_height": 2 }],
      "expect": {
        "cpp_category": "accepted",
        "expected_rust_category": "accepted",
        "rust_oracle": "chain/tests/nrd_validation_rules.rs process_block_nrd_validation (height 11)"
      }
    }
  ],
  "header_version_cases": [
    {
      "id": "nrd-in-header-version-3",
      "header_version": 3,
      "expected_rust": "rejected: NRDKernelPreHF3",
      "rust_oracle": "core/tests/block.rs block_with_nrd_kernel_pre_post_hf3",
      "expected_cpp": "rejected: NRD kernel ... not valid before header version 4",
      "cpp_test": "tests/src/PMMR/Test_NrdDifferential.cpp NrdHeaderVersionGateMatchesRustHf3Rule",
      "status": "FIXED in this line (BlockValidator required version >= 4)"
    },
    {
      "id": "nrd-in-header-version-4",
      "header_version": 4,
      "expected_rust": "accepted (kernel feature gate passes)",
      "rust_oracle": "core/tests/block.rs block_with_nrd_kernel_pre_post_hf3",
      "expected_cpp": "not rejected by the NRD header-version gate",
      "cpp_test": "tests/src/PMMR/Test_NrdDifferential.cpp NrdHeaderVersionGateMatchesRustHf3Rule",
      "status": "PASS"
    },
    {
      "id": "nrd-on-mainnet",
      "network": "Mainnet",
      "expected_rust": "rejected: NRDKernelNotEnabled (init_global_nrd_enabled(false) for Mainnet in src/bin/grin.rs)",
      "rust_oracle": "core/tests/block.rs block_with_nrd_kernel_nrd_not_enabled; src/bin/grin.rs 182-191",
      "expected_cpp": "accepted (Grin++ has no NRD feature flag)",
      "status": "KNOWN DIVERGENCE D2, documented only"
    },
    {
      "id": "nrd-on-testnet",
      "network": "Testnet",
      "expected_rust": "enabled (init_global_nrd_enabled(true) for non-Mainnet)",
      "rust_oracle": "src/bin/grin.rs 182-191",
      "expected_cpp": "enabled (NRD rules always applied)",
      "status": "PASS for rule enforcement; flag parity not applicable"
    }
  ]
}
